# Copy to .env and paste your real key. .env is gitignored.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Relevance check provider ----------------------------------------
# Which LLM judges "does this hadith answer the question". This is the one
# recurring cost in the app and the one place the model is swappable.
#
# Leave HADITH_LLM_PROVIDER unset and whichever key is present is used,
# preferring Anthropic. Set it explicitly to force one.
#
# Groq's free tier needs no credit card -- get a key at console.groq.com.
# Measure before trusting a swap: python3 compare_providers.py
HADITH_LLM_PROVIDER=
GROQ_API_KEY=
# HADITH_GROQ_MODEL=llama-3.3-70b-versatile
